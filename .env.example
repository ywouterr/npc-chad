# Copy to .env and fill in. Any OpenAI-compatible /chat/completions endpoint works.

# --- Option A (default): Claude Haiku 4.5 via Anthropic's OpenAI-compatible endpoint ---
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-4-5-20251001

# --- Option B: OpenRouter (one key, hundreds of models incl. very cheap ones) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=<model id from openrouter.ai/models>

# --- Option C: Google Gemini (OpenAI-compatible endpoint) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=<gemini api key>
# LLM_MODEL=<a flash / flash-lite model id>

# Set to 1 to try the UI without any API key (canned replies)
LLM_MOCK=0
PORT=3000
